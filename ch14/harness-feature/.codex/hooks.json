{
  "description": "테스트 파일 보호, 실제 결제 키 입력 차단, 완료 전 테스트·타입 검사와 한 번의 수정 기회",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/guard.sh\"",
            "timeout": 10,
            "statusMessage": "입력의 실제 결제 키 검사"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/guard.sh\"",
            "timeout": 10,
            "statusMessage": "테스트 파일 보호 및 실제 결제 키 검사"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/verify.sh\"",
            "timeout": 300,
            "statusMessage": "테스트·타입 검사 (수정 기회 최대 한 번)"
          }
        ]
      }
    ]
  }
}
