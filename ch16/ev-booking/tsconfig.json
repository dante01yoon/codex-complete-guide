{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src/rules/**/*.ts", "src/payments/**/*.ts", "src/mcp/**/*.ts", "tests/rules/**/*.ts", "tests/payments/**/*.ts", "tests/mcp/**/*.ts", "vitest.config.ts"]
}
